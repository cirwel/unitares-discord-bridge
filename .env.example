DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-guild-id-here
GOVERNANCE_MCP_URL=http://localhost:8767
ANIMA_MCP_URL=http://lumen.your-tailnet.ts.net:8766

# Bearer tokens for MCP service authentication
# GOVERNANCE_API_TOKEN=your-governance-token
# ANIMA_API_TOKEN=your-anima-token

# Optional: residents whose findings get their own channel instead of sharing
# #residents. Each key becomes a text channel of the same name.
# BRIDGE_RESIDENT_FINDING_CHANNELS=sentinel,doctor

# Optional: comma-separated deferred extensions to enable
# Available: autonomy, polls, resonance, dialectic, knowledge, presence
# BRIDGE_EXTENSIONS=autonomy,polls
